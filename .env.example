# Shared secret. mnemo must send the same value as PLUGIN_TOKEN. Generate one: openssl rand -hex 24
PLUGIN_TOKEN=
# Only for a port nobody else can reach. Without a token the server refuses to start.
# PLUGIN_ALLOW_ANONYMOUS=false

# PLUGIN_ADDR=0.0.0.0:8090
# MAX_CONCURRENCY=2          # tool calls running at once (document conversion is CPU-heavy)
# TOOL_TIMEOUT=120           # seconds for pandoc / TeX
# MAX_FILE_MB=30             # largest file a tool may return (Telegram bots can send up to 50 MB)
# MAX_REQUEST_MB=8

# Word: East-Asian font written into the document styles ("" leaves Word to choose)
# DOCX_CJK_FONT=Microsoft YaHei
# PDF: font used for Chinese text; empty = auto-detect (Noto Serif CJK SC, ...)
# PDF_CJK_FONT=
# PDF_CJK_MONO_FONT=

# Image generation: any OpenAI-compatible /images/generations endpoint (local Stable Diffusion / FLUX gateway, ...).
# The image_generate tool only exists when IMAGE_BASE_URL is set. DeepSeek has no image model.
# IMAGE_BASE_URL=http://192.168.0.231:7860/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=
# IMAGE_SIZE=1024x1024
# IMAGE_EXTRA_BODY={"steps": 25}   # merged into the request body (backend-specific options)
# IMAGE_TIMEOUT=300
